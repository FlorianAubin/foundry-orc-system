
<div class="orc spell-roll dice-roll spell-card">
  <header class="spell-header">
    <div class="spell-icon">✧</div>
  </header>

  <section class="spell-types">
    {{#if spellTypes.bases}}
      <div class="spell-type-row">
        <span class="type-icon">◇</span>
        <span class="type-label">{{localize "orc.spell.types.base"}}(s)</span>
        <strong>{{spellTypes.bases}}</strong>
      </div>
    {{/if}}

    {{#if spellTypes.shapes}}
      <div class="spell-type-row">
        <span class="type-icon">⬡</span>
        <span class="type-label">{{localize "orc.spell.types.shape"}}(s)</span>
        <strong>{{spellTypes.shapes}}</strong>
      </div>
    {{/if}}

    {{#if spellTypes.powers}}
      <div class="spell-type-row">
        <span class="type-icon">✦</span>
        <span class="type-label">{{localize "orc.spell.types.power"}}(s)</span>
        <strong>{{spellTypes.powers}}</strong>
      </div>
    {{/if}}

    {{#if spellTypes.modifs}}
      <div class="spell-type-row">
        <span class="type-icon">⚙</span>
        <span class="type-label">{{localize "orc.spell.types.modif"}}(s)</span>
        <strong>{{spellTypes.modifs}}</strong>
      </div>
    {{/if}}
  </section>

  <section class="spell-stats">
    {{#if costRoll.formula}}
      <div class="spell-stat cost-stat">
        <div class="stat-heading">
          <span class="stat-icon">◈</span>
          <span>{{localize "orc.spell.cost"}}</span>
        </div>
        <div class="stat-formula">{{costRoll.formula}}</div>
        <div class="stat-result">
          <strong>{{costRoll.total}}</strong>
          <span>
            {{#if useHP}}
              {{localize "orc.character.hp"}}
            {{else}}
              {{localize "orc.character.mp"}}
            {{/if}}
          </span>
        </div>
      </div>
    {{/if}}

    {{#if powerRoll.formula}}
      <div class="spell-stat power-stat">
        <div class="stat-heading">
          <span class="stat-icon">✦</span>
          <span>{{localize "orc.spell.power"}}</span>
        </div>
        <div class="stat-formula">{{powerRoll.formula}}</div>
        <div class="stat-result">
          <strong>{{powerRoll.total}}</strong>
        </div>
      </div>
    {{/if}}

    {{#if durationRoll.formula}}
      <div class="spell-stat duration-stat">
        <div class="stat-heading">
          <span class="stat-icon">⌛</span>
          <span>{{localize "orc.spell.duration"}}</span>
        </div>
        <div class="stat-formula">{{durationRoll.formula}}</div>
        <div class="stat-result">
          <strong>{{durationRoll.total}}</strong>
          <span>{{durationUnit}}</span>
        </div>
      </div>
    {{/if}}
  </section>

  <section class="spell-range">
    <span class="range-icon">◎</span>
    <div class="range-info">
      <span class="range-label">{{localize "orc.spell.range"}}</span>
      <strong>{{range}}</strong>
    </div>
  </section>

  {{#if effect}}
    <footer class="spell-effects">
      <span class="effect-icon">✧</span>
      <div>
        <span class="effect-label">Effets du sort</span>
        <p>{{effect}}</p>
      </div>
    </footer>
  {{/if}}
</div>
