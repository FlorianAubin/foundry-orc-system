
<div class="orc-chat-card consume-message deactivate-card">

  <header class="deactivate-header">
    <div class="deactivate-eyebrow">
      <span class="deactivate-line"></span>
      DÉSACTIVATION
      <span class="deactivate-line"></span>
    </div>

    <h2 class="deactivate-title">{{itemName}}</h2>

    <div class="deactivate-meta">
      <span>{{actorName}}</span>
      <span class="meta-separator">·</span>
      <span>{{itemType}}</span>
    </div>
  </header>

  <section class="deactivate-status">
    <div class="deactivate-icon">⌛</div>

    <div class="deactivate-status-content">
      <h3>Effet désactivé</h3>
      <p>L'effet a pris fin.</p>
    </div>

    <div class="deactivate-status-tag">
      <span class="status-dot"></span>
      INACTIF
    </div>
  </section>

</div>
