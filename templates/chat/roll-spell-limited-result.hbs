
<div class="orc spell-roll dice-roll spell-power-card">
  <header class="spell-header">
    <div class="spell-icon">✧</div>
    <div class="spell-heading">
      <h3 class="spell-title">{{title}}</h3>
      <span class="spell-subtitle">Manifestation arcanique</span>
    </div>
  </header>

  {{#if powerRoll.formula}}
    <section class="power-section">
      <div class="power-heading">
        <span class="power-icon">✦</span>
        <span>{{localize "orc.spell.power"}}</span>
      </div>

      <div class="power-result">
        <strong>{{powerRoll.total}}</strong>
      </div>

      {{#if powerTooltip}}
        <details class="power-details">
          <summary>Détails du jet</summary>
          <div class="power-tooltip">
            {{{powerTooltip}}}
          </div>
        </details>
      {{/if}}
    </section>
  {{/if}}

  {{#if effect}}
    <footer class="spell-effects">
      <div class="effect-icon">❖</div>
      <div class="effect-content">
        <span class="effect-label">Effets du sort</span>
        <div class="effect-text">{{effect}}</div>
      </div>
    </footer>
  {{/if}}
</div>
