
<form class="orc split-item-dialog">
  <div class="split-header">
    <div class="split-icon">⚖</div>
    <h3>{{localize "orc.dialog.splitItem.chooseSplit"}}</h3>
    <p>Choisis la quantité à séparer de la pile.</p>
  </div>

  <div class="form-group split-quantity">
    <label for="newStock">Quantité</label>
    <div class="quantity-control">
      <button type="button" class="quantity-btn" data-action="decrease" aria-label="Diminuer">−</button>
      <input
        id="newStock"
        type="number"
        name="newStock"
        value="1"
        min="1"
        step="1"
        autofocus
        required
      />
      <button type="button" class="quantity-btn" data-action="increase" aria-label="Augmenter">+</button>
    </div>
  </div>
</form>
